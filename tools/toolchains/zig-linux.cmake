# Windows-hosted Linux cross-build. Zig is supplied by the caller, never bundled.
set(CMAKE_SYSTEM_NAME Linux)
set(UGREENCTL_TARGET_ARCH "x86_64" CACHE STRING "Linux target: x86_64 or aarch64")
if(NOT UGREENCTL_TARGET_ARCH MATCHES "^(x86_64|aarch64)$")
  message(FATAL_ERROR "UGREENCTL_TARGET_ARCH must be x86_64 or aarch64")
endif()
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "This .cmd toolchain requires a Windows host; use a native Linux compiler on Linux")
endif()
if(NOT DEFINED ENV{UGREENCTL_ZIG} OR NOT EXISTS "$ENV{UGREENCTL_ZIG}")
  message(FATAL_ERROR "Set UGREENCTL_ZIG to the full path of an external zig.exe before configure and build")
endif()
set(CMAKE_SYSTEM_PROCESSOR "${UGREENCTL_TARGET_ARCH}")
set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/zigcc-linux-${UGREENCTL_TARGET_ARCH}.cmd")
set(CMAKE_AR "${CMAKE_CURRENT_LIST_DIR}/zigar.cmd")
set(CMAKE_RANLIB "${CMAKE_CURRENT_LIST_DIR}/zigranlib.cmd")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES UGREENCTL_TARGET_ARCH)
